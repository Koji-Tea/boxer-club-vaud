rules_version = '2';
// Règles d'accès de la base Boxer Club Vaud (à coller dans Console Firebase > Firestore Database > Règles, puis Publier).
// Garder d'accord avec ROLES et COLS dans js/donnees.js.
// - La vitrine (cours, moniteurs, wiki, comité, urgences, élevages, portées) est lisible par tout le monde.
// - Le tchat, les groupes, les messages privés, les inscriptions et la liste des adhérents sont réservés aux membres validés.
// - La comptabilité, la cabane, les contacts (e-mail, téléphone) et les cotisations sont réservés au comité.
// - Un nouveau compte est « en attente » jusqu'à ce que le comité lui donne un rôle. Le tout premier compte devient administrateur.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function setupPath() { return /databases/$(database)/documents/config/setup; }
    function role() { return signedIn() && exists(userPath(me())) ? get(userPath(me())).data.role : 'aucun'; }
    function allRoles() { return ['admin', 'president', 'caissier', 'resp_elevage', 'resp_cabane', 'resp_membres', 'comite', 'educ', 'moniteur', 'eleveur', 'adherent', 'membre', 'attente']; }
    function member() { return role() in ['admin', 'president', 'caissier', 'resp_elevage', 'resp_cabane', 'resp_membres', 'comite', 'educ', 'moniteur', 'eleveur', 'adherent', 'membre']; }
    // Le comité : voit la comptabilité, la cabane, les contacts et les cotisations.
    function comite() { return role() in ['admin', 'president', 'caissier', 'resp_elevage', 'resp_cabane', 'resp_membres', 'comite', 'educ']; }
    function coursEdit() { return role() in ['admin', 'president', 'resp_elevage', 'resp_cabane', 'educ', 'moniteur']; }
    function adhEdit() { return role() in ['admin', 'president', 'caissier', 'resp_membres', 'comite']; }
    function cotisEdit() { return role() in ['admin', 'president', 'caissier', 'resp_membres']; }
    function comptaEdit() { return role() in ['admin', 'president', 'caissier']; }
    function isAdmin() { return role() == 'admin'; }
    function chef() { return role() in ['admin', 'president']; }
    function sensitive(r) { return r in ['admin', 'president', 'caissier']; }
    // Changer un rôle de « from » vers « to » : admin seulement par l'admin ; président·e et caissier·ère par l'admin ou le/la président·e.
    function canGiveRole(from, to) {
      return isAdmin() || (chef() && from != 'admin' && to != 'admin') || (!sensitive(from) && !sensitive(to));
    }
    function breeder() { return role() == 'eleveur'; }
    function mine() { return request.resource.data.uid == me(); }
    function wasMine() { return resource.data.uid == me(); }
    function keys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function pseudoOwned(uid) { return getAfter(/databases/$(database)/documents/pseudos/$(request.resource.data.pk)).data.uid == uid; }
    function texteOk(t) { return t is string && t.size() > 0 && t.size() <= 2000; }
    // Réaction emoji : on ne change que sa propre réaction (reac.{uid}) et rien d'autre dans le message.
    function reaction() {
      let avant = resource.data.get('reac', {});
      let apres = request.resource.data.get('reac', {});
      return keys().hasOnly(['reac']) && apres.diff(avant).affectedKeys().hasOnly([me()])
        && (!(me() in apres) || (apres[me()] is string && apres[me()].size() <= 16));
    }

    // Réglages du club (textes de l'accueil, annonce, QR code d'adhésion…).
    match /config/main {
      allow read: if true;
      allow write: if comite();
    }
    // Marque que le premier administrateur existe : créée une seule fois, avec la fiche de cet admin.
    match /config/setup {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.admin == me()
        && getAfter(userPath(me())).data.role == 'admin';
    }

    // ----- Vitrine -----
    // Agenda : les responsables des cours gèrent tout ; chaque membre du comité crée des événements (pas des cours)
    // et ne modifie ou supprime que les siens.
    match /cours/{id} {
      function evt(d) { return d.get('type', 'cours') != 'cours'; }
      allow read: if true;
      allow create: if coursEdit() || (comite() && mine() && evt(request.resource.data));
      allow update: if coursEdit() || (comite() && wasMine() && evt(resource.data) && mine() && evt(request.resource.data));
      allow delete: if coursEdit() || (comite() && wasMine() && evt(resource.data));
    }
    match /moniteurs/{id} { allow read: if true; allow write: if coursEdit(); }
    match /wiki/{id}      { allow read: if true; allow write: if comite() || role() == 'moniteur'; }
    match /comite/{id}    { allow read: if true; allow write: if comite(); }
    match /urgences/{id}  { allow read: if true; allow write: if comite(); }
    // Élevages et portées : le comité gère tout, un·e éleveur·euse seulement ce qu'il ou elle a créé.
    match /elevages/{id} {
      allow read: if true;
      allow create: if comite() || (breeder() && mine());
      allow update: if comite() || (breeder() && wasMine() && mine());
      allow delete: if comite();
    }
    match /portees/{id} {
      allow read: if true;
      allow create: if comite() || (breeder() && mine());
      allow update: if comite() || (breeder() && wasMine() && mine());
      allow delete: if comite() || (breeder() && wasMine());
    }

    // ----- Comptes -----
    // Pseudo réservé (un document par pseudo) : sert à se connecter avec son pseudo. On peut lire un pseudo précis, pas la liste.
    match /pseudos/{p} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.email == request.auth.token.email;
      allow delete: if signedIn() && (resource.data.uid == me() || adhEdit());
    }
    match /users/{uid} {
      allow get: if signedIn() && (me() == uid || member());
      allow list: if member();
      // Inscription : en attente, ou administrateur si c'est le tout premier compte. Le pseudo doit être réservé dans la même opération.
      allow create: if signedIn() && me() == uid && pseudoOwned(uid)
        && (request.resource.data.role == 'attente'
            || (request.resource.data.role == 'admin' && !exists(setupPath()) && getAfter(setupPath()).data.admin == uid));
      // Chacun modifie son profil (pas son rôle) ; la gestion des adhérents change les rôles.
      allow update: if (me() == uid
            && keys().hasOnly(['pseudo', 'pk', 'prenom', 'chiens', 'chien', 'photo', 'bcv', 'bcs'])
            && (!keys().hasAny(['pk']) || pseudoOwned(uid)))
        || (adhEdit() && keys().hasOnly(['role']) && request.resource.data.role in allRoles()
            && canGiveRole(resource.data.role, request.resource.data.role));
      allow delete: if adhEdit() && me() != uid && canGiveRole(resource.data.role, 'attente');
    }
    // E-mail et téléphone : la personne elle-même et le comité.
    match /prives/{uid} {
      allow read: if signedIn() && (me() == uid || comite());
      allow write: if signedIn() && me() == uid;
    }
    // Cotisation payée ou non, avec la date de paiement (un document par compte).
    match /cotisations/{uid} {
      allow read: if signedIn() && (me() == uid || comite());
      allow write: if cotisEdit();
    }

    // ----- Espace membres -----
    // Inscription à un cours : une par personne et par cours (identifiant coursId_uid).
    match /inscriptions/{id} {
      allow read: if member();
      allow create: if member() && mine() && id == request.resource.data.cours + '_' + me()
        && exists(/databases/$(database)/documents/cours/$(request.resource.data.cours));
      allow delete: if signedIn() && (wasMine() || coursEdit()
        || (comite() && get(/databases/$(database)/documents/cours/$(resource.data.cours)).data.uid == me()));
    }
    // Tchat général.
    match /messages/{id} {
      allow read: if member();
      allow create: if member() && mine() && texteOk(request.resource.data.texte)
        && request.resource.data.pseudo == get(userPath(me())).data.pseudo;
      allow update: if member() && reaction();
      allow delete: if signedIn() && (wasMine() || comite());
    }
    // Groupes de discussion : créés par le comité ; chacun·e rejoint ou quitte un groupe ouvert (seulement soi-même).
    // Un groupe privé (prive == true) est caché : seuls ses membres le voient, et seul un membre du comité qui en fait partie
    // y invite des personnes. L'administrateur·rice voit tous les groupes (pour supprimer un groupe abandonné), pas leurs messages.
    match /groupes/{g} {
      function ouvert(d) { return d.get('prive', false) == false; }
      function dedans(d) { return me() in d.membres; }
      function joinLeave() {
        let a = request.resource.data.membres.toSet();
        let b = resource.data.membres.toSet();
        return keys().hasOnly(['membres'])
          && ((a.difference(b) == [me()].toSet() && b.difference(a).size() == 0 && ouvert(resource.data))
              || (b.difference(a) == [me()].toSet() && a.difference(b).size() == 0));
      }
      allow get: if member() && (ouvert(resource.data) || dedans(resource.data) || isAdmin());
      allow list: if member() && (resource.data.prive == false || dedans(resource.data) || isAdmin());
      allow create: if comite() && (ouvert(request.resource.data) || dedans(request.resource.data));
      allow delete: if comite() && (ouvert(resource.data) || dedans(resource.data) || isAdmin());
      allow update: if (comite() && (ouvert(resource.data) || dedans(resource.data) || isAdmin()))
        || (member() && joinLeave());
      // Le fil d'un groupe : lu et écrit par ses membres seulement.
      match /msgs/{m} {
        function inGroup() { return member() && me() in get(/databases/$(database)/documents/groupes/$(g)).data.membres; }
        allow read: if inGroup();
        allow create: if inGroup() && mine() && request.resource.data.g == g && texteOk(request.resource.data.texte);
        allow update: if inGroup() && reaction();
        allow delete: if signedIn() && (wasMine() || comite());
      }
    }
    // Messages privés : la conversation {uidA_uidB} n'est lisible que par ses deux participant·es.
    match /convs/{c} {
      function inConv() { return member() && me() in c.split('_'); }
      allow read: if signedIn() && me() in resource.data.p;
      allow create, update: if inConv() && request.resource.data.p == c.split('_');
      match /msgs/{m} {
        allow read: if signedIn() && me() in c.split('_');
        allow create: if inConv() && mine() && request.resource.data.c == c && texteOk(request.resource.data.texte);
        allow update: if inConv() && reaction();
        allow delete: if signedIn() && wasMine();
      }
    }
    // Notifications de l'app (enveloppe) : chacun·e lit et range les siennes.
    match /notifs/{id} {
      allow read: if signedIn() && resource.data.to == me();
      allow create: if member() && request.resource.data.from == me() && request.resource.data.to is string
        && request.resource.data.titre is string && request.resource.data.titre.size() <= 150;
      allow update: if signedIn() && resource.data.to == me() && keys().hasOnly(['lu']);
      allow delete: if signedIn() && resource.data.to == me();
    }

    // ----- Comité : comptabilité et cabane -----
    match /compta/{an}      { allow read: if comite(); allow write: if comptaEdit(); }
    match /ecritures/{id}   { allow read: if comite(); allow write: if comptaEdit(); }
    // Factures : chaque membre du comité en ajoute (scan) ; seuls admin, président·e et caissier·ère les marquent payées.
    match /factures/{id} {
      allow read: if comite();
      allow create: if comptaEdit() || (comite() && mine() && request.resource.data.payee == false);
      allow update: if comptaEdit()
        || (comite() && wasMine() && mine() && resource.data.payee == false && request.resource.data.payee == false);
      allow delete: if comptaEdit() || (comite() && wasMine() && resource.data.payee == false);
    }
    // Notes de frais : chaque membre du comité crée les siennes et les modifie tant qu'elles ne sont pas payées.
    match /notes/{id} {
      allow read: if comite();
      allow create: if comite() && mine() && request.resource.data.payee == false;
      allow update: if comptaEdit()
        || (comite() && wasMine() && mine() && resource.data.payee == false && request.resource.data.payee == false);
      allow delete: if comptaEdit() || (comite() && wasMine() && resource.data.payee == false);
    }
    // Factures, tickets scannés et carnets de vaccination (un document par fichier, moins de 1 Mo).
    // Chacun·e lit ses propres fichiers ; le comité lit tout.
    // Les photos de la galerie (galerie == true) sont lisibles par tous les membres.
    match /fichiers/{id} {
      allow read: if comite() || (signedIn() && resource.data.uid == me()) || (member() && resource.data.get('galerie', false) == true);
      allow create: if signedIn() && mine();
      allow delete: if comptaEdit() || (comite() && (wasMine() || resource.data.get('galerie', false) == true));
    }
    match /cabane/{id}      { allow read, write: if comite(); }
    // Galerie photo : vue par les membres, créée et complétée par le comité.
    match /galeries/{id}    { allow read: if member(); allow write: if comite(); }
    // Archives du comité : PV, convocations, correspondance.
    match /docscomite/{id}  { allow read, write: if comite(); }
  }
}
